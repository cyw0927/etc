# Copy to .env and fill in. Never commit .env (this repository is public).

# Optional. Free key from https://fred.stlouisfed.org/docs/api/api_key.html
# Enables vintage (real-time) US macro data so CPI/unemployment/industrial production/M2 can be used
# as model inputs without look-ahead from later revisions. Without it, macro series are display-only.
FRED_API_KEY=

# Optional. Needed only for the research agent prototype (scripts/agent_ask.py). https://console.anthropic.com
ANTHROPIC_API_KEY=
